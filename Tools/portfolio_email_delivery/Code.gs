function identityTextContains_(text,name){return normalizeIdentityText_(text).indexOf(normalizeIdentityText_(name))>=0;}
function normalizeIdentityText_(s){return String(s||'').toLowerCase().replace(/&nbsp;/g,' ').replace(/<[^>]+>/g,' ').replace(/[^a-z0-9]+/g,' ').trim().replace(/\s+/g,' ');}
function safeNote_(v){const s=String(v==null?'':v).replace(/\r\n/g,'\n').trim();if(s.length>PORTFOLIO_EMAIL.NOTE_MAX_LENGTH)throw new Error('A note is too long.');return s;}
function firstName_(n){const s=String(n||'').trim();if(!s)return'your student';return s.includes(',')?(s.split(',')[1].trim().split(/\s+/)[0]||s):s.split(/\s+/)[0];}
function normalizeEmail_(v){return String(v||'').trim();}function isValidEmail_(v){return /^[^\s@,;]+@[^\s@,;]+\.[^\s@,;]+$/.test(String(v||'').trim());}
function safeFileName_(s){return String(s).replace(/[\\/:*?"<>|]+/g,'_').replace(/\s+/g,'_');}
function trashFiles_(folder){const it=folder.getFiles();while(it.hasNext())it.next().setTrashed(true);}
function requireSingleFolder_(p,n){const it=p.getFoldersByName(n);if(!it.hasNext())throw new Error('Missing Drive folder: '+n);const f=it.next();if(it.hasNext())throw new Error('Duplicate Drive folders named '+n);return f;}
function getOptionalSingleFolder_(p,n){const it=p.getFoldersByName(n);if(!it.hasNext())return null;const f=it.next();if(it.hasNext())throw new Error('Duplicate Drive folders named '+n);return f;}
function requireSingleFile_(f,n){const x=getOptionalSingleFile_(f,n);if(!x)throw new Error('Missing private Portfolio file: '+n);return x;}
function getOptionalSingleFile_(f,n){const it=f.getFilesByName(n);if(!it.hasNext())return null;const x=it.next();if(it.hasNext())throw new Error('Duplicate private Portfolio files named '+n);return x;}
function getConfig_(){const p=PropertiesService.getScriptProperties().getProperties(),c={rootFolderId:String(p.PORTFOLIO_ROOT_FOLDER_ID||'').trim(),teacherEmail:String(p.TEACHER_EMAIL||'').trim().toLowerCase(),teacherDisplayName:String(p.TEACHER_DISPLAY_NAME||'').trim()};if(!c.rootFolderId||!isValidEmail_(c.teacherEmail)||!c.teacherDisplayName)throw new Error('Missing/invalid Script Properties.');return c;}
function assertAuthorized_(){const c=getConfig_(),a=String(Session.getActiveUser().getEmail()||'').trim().toLowerCase();if(!a||a!==c.teacherEmail)throw new Error('Access blocked.');return true;}
function sha256Text_(t){return bytesToHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(t),Utilities.Charset.UTF_8));}function sha256Bytes_(b){return bytesToHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,b));}function bytesToHex_(b){return b.map(x=>('0'+((x<0?x+256:x).toString(16))).slice(-2)).join('');}
function csvLine_(v){return v.map(x=>{const s=String(x==null?'':x);return /[",\r\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;}).join(',');}
function naturalCompare_(a,b){return String(a||'').localeCompare(String(b||''),undefined,{numeric:true,sensitivity:'base'});}function safeError_(e){return String(e&&e.message?e.message:e||'Unknown error').slice(0,500);}