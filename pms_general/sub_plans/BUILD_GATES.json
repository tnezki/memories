{
  "schema": "sub-plans-build-gates/1.0",
  "status": "required",
  "student_page": {
    "show_time_budget": false,
    "show_authoring_metadata": false,
    "show_source_ids": false,
    "required_reflection_after_each_problem": [
      "Knew how to do it",
      "Had to ask for help",
      "Had to look it up"
    ]
  },
  "timing": {
    "minutes_less_than_period": {
      "Physics": 10,
      "Algebra 1": 15,
      "AP Calculus AB": 10
    },
    "require_item_level_estimate": true,
    "short_one_step_max_minutes": 0.5,
    "allowed_under_target_minutes": 3,
    "fail_if_target_is_met_only_by_inflated_quick_item_estimates": true
  },
  "evidence_mix": {
    "required_lanes": [
      "recent_already_covered_mastery_or_i_can_evidence",
      "current_section_evidence",
      "challenge_extension"
    ],
    "map_before_authoring": true
  },
  "physics_section_1_3": {
    "quick_collinear_net_force_items_min": 2,
    "quick_collinear_net_force_items_max": 3,
    "two_vector_nonparallel_grid_items": 3,
    "three_vector_investigation_items": 2,
    "typical_total_problem_range": [10, 12],
    "must_add_other_aligned_items_if_needed_for_time_target": true,
    "grid_style_source": "tnezki/physics:investigations/u1_3_investigation/u1_3_investigation.html",
    "student_result": "draw resultant on same grid and report magnitude plus direction as angle from +x or valid compass form"
  },
  "runtime_controls": {
    "all_workspaces": "sets every problem workspace directly",
    "problem_selector": "selects one problem for individual controls",
    "selected_workspace": "changes only selected problem",
    "selected_visual": "changes only selected problem graph_or_diagram",
    "selected_controls_disabled_when_problem_all": true,
    "reset": "all workspace and visual values return to 100 percent",
    "live_repagination": true,
    "changing_one_problem_may_change_page_flow_but_not_other_problem_sizes": true
  },
  "mathjax": {
    "local_svg_required": true,
    "canonical_delimiters": ["\\(...\\)", "\\[...\\]"],
    "registered_finalizer_required": true,
    "visual_inspection_after_typeset_required": true,
    "raw_tex_visible_count_required": 0,
    "malformed_authoring_expression_visible_count_required": 0
  },
  "cartesian_graphs": {
    "registered_renderer_required": "Tools/MANIFEST.json -> tools.graph_tool",
    "district_graph_standard_required": "district_tools/_shared/DISTRICT_GRAPH_RENDERING_STANDARD.md",
    "hand_built_cartesian_svg_css_allowed": false,
    "provenance_record_required": true,
    "accuracy_visual_check_required": true
  },
  "qa_fail_conditions": [
    "student page displays work-time target or timing arithmetic",
    "time estimate is more than 3 minutes under target",
    "required evidence lane is absent",
    "Physics 1.3 is reduced below the locked task shape without equivalent teacher-approved replacement",
    "selected visual control changes more than the selected problem",
    "raw or malformed MathJax is visible",
    "Cartesian graph bypasses the registered graph tool",
    "required relative link is broken"
  ]
}
