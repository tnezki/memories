{
  "schema": "curriculum-framework-manifest/1.0",
  "course": "Physics",
  "entrypoint": "frameworks/Physics/FRAMEWORK.txt",
  "resource_root": "frameworks/2_Framework_Physics/Conceptual_Physics_Framework",
  "storage": "expanded",
  "note": "FRAMEWORK.txt is the stable authority front door. resource_root preserves the current large supporting tree without mass-moving assets.",
  "assessment_plan_pattern": "frameworks/2_Framework_Physics/Conceptual_Physics_Framework/assessment_plans/original/unitN_assessment_plan/unitN_assessment_plan.html",
  "bank_profiles": {
    "legacy_bank": "frameworks/2_Framework_Physics/Conceptual_Physics_Framework/profiles/bank_course_profile.json",
    "bank_v2_map": "frameworks/2_Framework_Physics/Conceptual_Physics_Framework/profiles/bank_v2_course_profile.json"
  },
  "bank_v2_runtime_files": [
    "frameworks/2_Framework_Physics/Conceptual_Physics_Framework/profiles/bank_v2_course_profile.json",
    "frameworks/2_Framework_Physics/Conceptual_Physics_Framework/curriculum/i_can_index.json"
  ],
  "bank_v2_note": "For Steps 2.5/2.6 Bank-v2 pilot work, bank_v2_map is the manifest-declared course profile. legacy_bank remains only for the currently deployed Stage 3A-3E pipeline until those stages are upgraded after map approval.",
  "notes_runtime_files": [
    "frameworks/2_Framework_Physics/Conceptual_Physics_Framework/profiles/notes_course_profile.json",
    "frameworks/2_Framework_Physics/Conceptual_Physics_Framework/profiles/language_reading_tone.json",
    "frameworks/2_Framework_Physics/Conceptual_Physics_Framework/contracts/notes_visual_contract.json",
    "frameworks/2_Framework_Physics/Conceptual_Physics_Framework/curriculum/section_index.json",
    "frameworks/2_Framework_Physics/Conceptual_Physics_Framework/curriculum/i_can_index.json"
  ],
  "course_resources": {
    "physics_notes_image_toolkit": {
      "repo_scope": "course",
      "root": "resources/Physics_Notes_Image_Toolkit",
      "catalog": "resources/Physics_Notes_Image_Toolkit/IMAGE_CATALOG.json",
      "version_manifest": "resources/Physics_Notes_Image_Toolkit/version_manifest.json",
      "asset_path_rule": "resources/Physics_Notes_Image_Toolkit/<toolkit_path>",
      "delivery": "reference_in_place",
      "note": "Course-owned Physics Notes visuals. 4A selects from this resource; 4B references selected assets at their canonical course-repo paths instead of copying toolkit binaries into Notes."
    },
    "physics_textbook": {
      "repo_scope": "external",
      "repo": "tnezki/textbooks",
      "root": "physics",
      "index": "physics/index.html",
      "unit_root_pattern": "physics/units/unitN",
      "section_pattern": "physics/units/unitN/section_N_S.html",
      "delivery": "reference_in_place",
      "role": "notes_instructional_spine",
      "note": "Canonical Physics textbook source used as the instructional spine for Stage 4A Notes mapping and Stage 4B Notes adaptation. Resolve the repository commit once per run and keep it pinned for that run."
    }
  }
}
