{
  "schema": "algebra-mastery-recurrence-map/1.0",
  "status": "CURRENT",
  "course": "Algebra 1",
  "purpose": "Plan meaningful section-level recurrence between formal Intro, Review, and Mastery placements so goals return often enough for durable learning without forcing every section to be single-goal practice.",
  "principles": [
    "Formal Intro/Review/Mastery placement and recurrence frequency are different concepts.",
    "Unit 1 is an opening-course exception; about 3 meaningful section appearances is normal.",
    "Unit 2 is a transition exception; about 6 meaningful section appearances is normal.",
    "Unit 3+ aims for about 9 meaningful section appearances across the full Intro-Review-Mastery cycle.",
    "3+3+3 is the clean default when timing allows; nearby distributions such as 2+3+4 or 1+4+4 are valid for late-introduced goals.",
    "An appearance can be only one or two mixed-practice questions; spacing matters more than raw count.",
    "Warm-Up Q3/Q4 retrievals are extra exposure and are not counted in section_appearance_total.",
    "Practice/Activity recurrence questions should be mixed across multiple Mastery Goals rather than all coming from one current formal Mastery Goal."
  ],
  "practice_target_plan": {
    "normal_set_size": 12,
    "allowed_set_size": [
      12,
      13,
      14,
      15,
      16
    ],
    "current_intro_questions_default": 4,
    "recurrence_questions_default": 8,
    "pair_A": [
      "Practice 1",
      "Activity Set 1"
    ],
    "pair_B": [
      "Extra Practice",
      "Activity Set 2"
    ],
    "pair_rule": "Each pair shares the same selected I Can/count plan but uses fresh families/instances. Pair B intentionally overlaps high-priority recurrence targets from Pair A while rebalancing some slots."
  },
  "warmup_overlay": {
    "warmups_per_unit": 20,
    "ican_slots_per_warmup": [
      "Q3",
      "Q4"
    ],
    "rule": "Warm-Up retrieval is additional to this map. Unit 3+ favors previous-unit I Cans in Q3 and two-units-back/long-range I Cans in Q4."
  },
  "dashboard_integration": {
    "status": "REQUIRED_FUTURE",
    "rule": "When the Teacher Dashboard is reorganized, surface this recurrence map and the Set Builder recommendations so the teacher can inspect/edit the planned I Can mix before generating sets."
  },
