  "updated": "2026-09-19",
  "scope_note": "Curated, solved representative morphology specimens. These are previews/QA exemplars, not source questions and not templates to copy verbatim into generated worksheets.",
  "policy": {
    "no_fallback_invention": "If a family has no curated specimen, the teacher preview must say preview pending quality review rather than inventing a generic question or visual.",
    "student_prompt_rule": "Evidence-job, student-action, summary, and category metadata are never student-facing prompt text.",
    "visual_rule": "A preview visual must be family-specific: systems show two lines, transformation families show source and image figures, slope/equation families show the required line, and nonvisual algebra families do not receive decorative graphs."
  },
